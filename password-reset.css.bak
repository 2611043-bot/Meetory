/* フォームグループ */
.form-group {
    margin-bottom: 20px;
}

/* ラベル */
.form-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: bold;
    color: #34495e;
}

/* 入力欄 */
.form-group input {
    width: 100%;
    box-sizing: border-box;
    padding: 13px 15px;
    border: 1px solid #cddfea;
    border-radius: 8px;
    font-size: 16px;
    outline: none;
    transition: 0.2s;
}

/* 入力欄フォーカス時 */
.form-group input:focus {
    border-color: #2196f3;
    box-shadow: 0 0 0 3px rgba(33, 150, 243, 0.12);
}

/* 送信ボタン */
.reset-button {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 8px;
    background: linear-gradient(135deg, #2196f3, #1976d2);
    color: white;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.2s;
}

/* 送信ボタンホバー時 */
.reset-button:hover {
    background: linear-gradient(135deg, #1976d2, #1565c0);
}

