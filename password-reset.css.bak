/* 入力欄 */
.form-group {
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin-bottom: 25px;
}

.form-group label {
    font-size: 14px;
    font-weight: bold;
    color: #444;
}

.form-group input {
    width: 100%;
    padding: 13px;
    border: 1px solid #d0d7de;
    border-radius: 7px;
    font-size: 15px;
    box-sizing: border-box;
    outline: none;
}

.form-group input:focus {
    border-color: #1a73e8;
    box-shadow: 0 0 0 3px rgba(26, 115, 232, 0.12);
}

/* 送信ボタン */
.reset-submit-btn {
    width: 100%;
    padding: 13px;
    border: none;
    border-radius: 7px;
    background-color: #1a73e8;
    color: #ffffff;
    font-size: 15px;
    font-weight: bold;
    cursor: pointer;
    transition: background-color 0.2s;
}

.reset-submit-btn:hover {
    background-color: #0d47a1;
}

/* ログイン画面へのリンク */
.back-login-link {
    display: block;
    margin-top: 25px;
    text-align: center;
    color: #1a73e8;
    font-size: 14px;
    text-decoration: none;
}

.back-login-link:hover {
    text-decoration: underline;
}

